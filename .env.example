# Copy this file to .env.local and add your own credentials there.
# Do not put real secrets in this template or commit .env.local.

# PostgreSQL (pooled application connection plus direct migration connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Clerk development/production application keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Cloudinary signed-upload configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Billing must remain disabled until payment consent and billing are implemented.
BILLING_ENABLED=false

# Required by the protected Vercel expiry cron; generate a random secret.
CRON_SECRET=

# Canonical public origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional for manual one-time admin seeding. Otherwise the verified configured email is promoted on sign-in.
SEED_ADMIN_CLERK_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME="ThuisZoek beheerder"
SEED_ADMIN_NAME="ThuisZoek beheerder"
